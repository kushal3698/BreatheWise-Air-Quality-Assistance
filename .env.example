# ==============================================================================
# BreatheWise Environment Variables Configuration Template
# ==============================================================================

# --- Application Mode ---
DEMO_MODE=true
DEFAULT_CITY=Delhi
APP_ENV=development
LOG_LEVEL=INFO

# --- Backend API & CORS Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://breathewise-air-quality-assistance.vercel.app

# --- GenAI / LLM Settings (Optional for offline demo mode) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Telemetry & Air Quality Providers ---
AQI_PROVIDER=open-meteo
AQI_CACHE_TTL_SECONDS=900
WAQI_TOKEN=
OPENAQ_API_KEY=

# --- RAG Knowledge Base ---
KNOWLEDGE_BASE_PATH=./app/knowledge_base
